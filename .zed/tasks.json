[
  {
    "label": "Build CoderDojoVR Website TailwindCSS",
    "command": "tailwindcss",
    "args": ["-wmi", "static/assets/styles/main.src.css", "-o", "static/assets/styles/main.min.css"],
    "allow_concurrent_runs": false
  },
  {
    "label": "Run CoderDojoVR Website dev server",
    "command": "zola",
    "args": ["serve", "-i", "0.0.0.0", "-p", "8000"],
    "allow_concurrent_runs": false
  }
]
